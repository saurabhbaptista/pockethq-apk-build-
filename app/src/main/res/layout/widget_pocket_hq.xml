<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="15dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="POCKET HQ / FOCUS" android:textSize="11sp" android:textStyle="bold" android:letterSpacing=".13"
        android:textColor="#B6F3D8"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="● LOCAL" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="4dp"
        android:paddingBottom="4dp" android:background="@drawable/widget_chip"
        android:textSize="10sp" android:textColor="#A6ECD7" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="6dp">
      <TextView android:id="@+id/widget_focus" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:text="Open Pocket HQ"
        android:singleLine="true" android:ellipsize="end" android:textSize="23sp"
        android:fontFamily="sans" android:textStyle="bold" android:textColor="#F1F8F7"/>
      <TextView android:id="@+id/widget_focus_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="ACTIVE" android:textSize="10sp"
        android:textColor="#B9D4CC" android:paddingLeft="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/widget_focus_card"
        android:padding="11dp" android:layout_marginTop="9dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="NEXT ACTION" android:textSize="10sp" android:letterSpacing=".12"
        android:textColor="#A6ECD7" android:textStyle="bold"/>
      <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Open Pocket HQ to update this action." android:layout_marginTop="3dp"
        android:maxLines="3" android:ellipsize="end" android:textSize="12sp"
        android:lineSpacingExtra="2dp" android:textColor="#E4F1EE"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_active" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="4" android:textColor="#F5FAF9" android:textStyle="bold" android:textSize="22sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ACTIVE" android:letterSpacing=".08" android:textColor="#9AC4B7" android:textSize="9sp"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_queued" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="6" android:textColor="#F5FAF9" android:textStyle="bold" android:textSize="22sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="QUEUED" android:letterSpacing=".08" android:textColor="#9AC4B7" android:textSize="9sp"/>
      </LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_done" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="1" android:textColor="#A6ECD7" android:textStyle="bold" android:textSize="22sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SHIPPED" android:letterSpacing=".08" android:textColor="#9AC4B7" android:textSize="9sp"/>
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_build_section" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"
      android:paddingTop="10dp" android:background="@drawable/widget_rule" android:visibility="gone">
      <TextView android:id="@+id/widget_build_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="UP NEXT" android:textColor="#A6ECD7"
        android:letterSpacing=".12" android:textSize="10sp" android:textStyle="bold"/>
      <TextView android:id="@+id/widget_build" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Choose your next small build"
        android:textColor="#F1F8F7" android:textSize="14sp" android:maxLines="2"
        android:ellipsize="end" android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_upcoming_section" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"
      android:visibility="gone">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="FOLLOWING BUILD" android:letterSpacing=".12" android:textColor="#8FAEA7"
        android:textSize="10sp" android:textStyle="bold"/>
      <TextView android:id="@+id/widget_upcoming" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Nothing else queued"
        android:textColor="#C8DDDA" android:textSize="12sp" android:maxLines="1"
        android:ellipsize="end" android:layout_marginTop="3dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_radar_section" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp"
      android:visibility="gone">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="PROJECT RADAR" android:letterSpacing=".12" android:textColor="#A6ECD7"
          android:textStyle="bold" android:textSize="10sp"/>
      <LinearLayout android:id="@+id/radar_row_1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/radar_name_1" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Project" android:textStyle="bold"
          android:textColor="#E9F5F1" android:textSize="12sp"/>
        <TextView android:id="@+id/radar_next_1" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Next action" android:textColor="#AFC6BE"
          android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/radar_row_2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/radar_name_2" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Project" android:textStyle="bold"
          android:textColor="#E9F5F1" android:textSize="12sp"/>
        <TextView android:id="@+id/radar_next_2" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Next action" android:textColor="#AFC6BE"
          android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/radar_row_3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/radar_name_3" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Project" android:textStyle="bold"
          android:textColor="#E9F5F1" android:textSize="12sp"/>
        <TextView android:id="@+id/radar_next_3" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Next action" android:textColor="#AFC6BE"
          android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/radar_row_4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="7dp">
        <TextView android:id="@+id/radar_name_4" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Project" android:textStyle="bold"
          android:textColor="#E9F5F1" android:textSize="12sp"/>
        <TextView android:id="@+id/radar_next_4" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="Next action" android:textColor="#AFC6BE"
          android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_recent_section" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp"
      android:visibility="gone">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="LAST ACTIVITY" android:letterSpacing=".12" android:textColor="#A6ECD7"
          android:textStyle="bold" android:textSize="10sp"/>
      <TextView android:id="@+id/widget_recent" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="No recent activity"
          android:layout_marginTop="4dp" android:textColor="#D3E6E1" android:textSize="11sp"
          android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="LOCAL SNAPSHOT"
        android:textSize="9sp" android:letterSpacing=".04" android:textColor="#86A8A0"/>
</LinearLayout>